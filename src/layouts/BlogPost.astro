---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import ScrollTop from '../components/ScrollTop.astro';
import RelatedPosts from '../components/RelatedPosts.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import Banner from '../components/Banner.astro';
import BannerDataInjector from '../components/BannerDataInjector.astro';
import AdBanner from '../components/AdBanner.astro';
import FAQ from '../components/FAQ.astro';
import Disclaimer from '../components/Disclaimer.astro';
import { getLangFromUrl, useTranslations, useTranslatedPath } from '../i18n/utils';

interface Props {
	title: string;
	description: string;
	metaOgTitle?: string; // OG заголовок для соцсетей (опционально)
	readingTime?: number; // Время чтения в минутах (вычисляется автоматически)
	pubDate?: Date | string;
	updatedDate?: Date | string;
	heroImage?: string;
	bannerImage?: string;
	category?: string;
	tags?: string[];
	faq?: { q: string; a: string }[];
	postId?: string;
	headings?: { depth: number; slug: string; text: string }[];
	customBreadcrumbs?: { label: string; href?: string }[];
}

// Helper to convert string to Date (Astro 5 collections return dates as strings)
const toDate = (d: Date | string | undefined): Date | undefined =>
	d ? (typeof d === 'string' ? new Date(d) : d) : undefined;

const { title, description, metaOgTitle, readingTime, pubDate, updatedDate, heroImage, bannerImage, category, tags, faq, postId, headings, customBreadcrumbs } = Astro.props;
const displayImage = heroImage || bannerImage;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

// Содержание на разных языках
const tocTitle = {
	ru: 'В этой статье',
	en: 'In this article'
}[lang] || 'В этой статье';

const breadcrumbItems: Array<{ label: string; href?: string }> = customBreadcrumbs || (() => {
	const items: Array<{ label: string; href?: string }> = [
		{ label: t('nav.saga'), href: translatePath('saga') }
	];
	
	// Добавляем категорию в хлебные крошки, если она указана
	if (category) {
		const catLabel = t(`cat.${category}` as any);
		if (catLabel) {
			items.push({ label: catLabel, href: translatePath('saga') });
		}
	}
	
	items.push({ label: title });
	return items;
})();
---

<html lang={lang} data-astro-transition="slide">
	<head>
		
		<BaseHead title={title} description={description} metaOgTitle={metaOgTitle} image={displayImage} />
		
		{/* Schema.org Article */}
		{pubDate && (() => {
			const pubDateObj = toDate(pubDate)!;
			const updatedDateObj = toDate(updatedDate);
			// TS: держим как any, т.к. поле image добавляется условно
			const articleSchema: any = {
				"@context": "https://schema.org",
				"@type": "Article",
				"headline": title,
				"description": description,
				"author": {
					"@type": "Person",
					"name": "Hampfree"
				},
				"datePublished": pubDateObj.toISOString(),
				"dateModified": updatedDateObj ? updatedDateObj.toISOString() : pubDateObj.toISOString(),
				"publisher": {
					"@type": "Organization",
					"name": "FÉLAG",
					"url": Astro.site?.href || "https://felag.online",
					"logo": {
						"@type": "ImageObject",
						"url": new URL("/logo.svg", Astro.site || "https://felag.online").href
					}
				},
				"mainEntityOfPage": {
					"@type": "WebPage",
					"@id": Astro.url.href
				}
			};
			
			if (displayImage) {
				articleSchema.image = {
					"@type": "ImageObject",
					"url": new URL(displayImage, Astro.site || "https://felag.online").href
				};
			}
			
			return (
				<script type="application/ld+json" set:html={JSON.stringify(articleSchema, null, 0)} />
			);
		})()}
	</head>

	<body>
		<Header />
		<main class="container">
			<div class="layout-grid">
				<article class="fade-in" data-category={category || ''}>
					<Breadcrumb items={breadcrumbItems} />
					
					{pubDate && (
						<div class="post-meta">
							<FormattedDate date={pubDate} />
							{updatedDate && <span>· обновлено <FormattedDate date={updatedDate} /></span>}
							{readingTime && readingTime > 0 && (
								<span>· {readingTime} {lang === 'ru' ? 'мин чтения' : 'min read'}</span>
							)}
						</div>
					)}

					<Banner 
						title={title} 
						subtitle={description}
						category={category} 
						type="full" 
						className="hero-img"
					/>

					<!-- Mobile TOC toggle button (hidden on desktop) -->
					<button class="mobile-toc-toggle" aria-expanded="false" aria-controls="mobile-toc-accordion">
						<span class="toc-icon">📖</span>
						<span class="toc-label">{tocTitle}</span>
						<span class="toc-chevron">▾</span>
					</button>

					<!-- Mobile TOC accordion (hidden on desktop) -->
					<div class="mobile-toc-accordion" id="mobile-toc-accordion">
						<div class="toc-inner">
							<p class="toc-title">{tocTitle}</p>
							<ul class="toc-list">
								{headings?.map((heading) => {
									const paddingLeft =
										heading.depth === 2 ? '0' :
										heading.depth === 3 ? 'var(--space-md)' :
										heading.depth === 4 ? 'var(--space-lg)' :
										`calc(var(--space-md) * ${Math.max(1, heading.depth - 2)})`;
									return (
										<li class="toc-item" style={`padding-left: ${paddingLeft}`}>
											<a href={`#${heading.slug}`}>{heading.text}</a>
										</li>
									);
								})}
							</ul>
						</div>
					</div>

					<div class="prose">
						<slot />
					</div>

					{/* SSR-rendered ad banner — moved by minimal JS after 2nd H2 */}
					<div id="ad-banner-slot" style="display:none">
						<AdBanner category={category || ''} lang={lang} />
					</div>

					{postId && (
						<div class="related-posts-container">
							<div class="section-label">{t('home.recent_label')}</div>
							<RelatedPosts currentPostId={postId} category={category} />
						</div>
					)}

					<div class="post-disclaimer">
						<Disclaimer />
					</div>
				</article>

				<!-- Desktop TOC (hidden on mobile) -->
				<aside class="toc-sticky">
					<p class="toc-title">{tocTitle}</p>
					<ul class="toc-list">
						{headings?.map((heading) => {
							const paddingLeft =
								heading.depth === 2 ? '0' :
								heading.depth === 3 ? 'var(--space-md)' :
								heading.depth === 4 ? 'var(--space-lg)' :
								`calc(var(--space-md) * ${Math.max(1, heading.depth - 2)})`;
							return (
								<li class="toc-item" style={`padding-left: ${paddingLeft}`}>
									<a href={`#${heading.slug}`}>{heading.text}</a>
								</li>
							);
						})}
					</ul>
				</aside>
			</div>

			<ScrollTop />
		</main>
		<BannerDataInjector />
		<Footer />

		<!-- Article image lightbox overlay (single instance per page) -->
		<div class="article-image-lightbox" role="dialog" aria-modal="true" aria-label="Просмотр изображения" hidden>
			<div class="lightbox-backdrop"></div>
			<div class="lightbox-content">
				<button class="lightbox-close" aria-label="Закрыть изображение">
					<svg viewBox="0 0 24 24"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
				</button>
				<img src="" alt="" class="lightbox-img" />
			</div>
		</div>

		<script defer src="/scripts/lightbox.mjs"></script>

		<script is:inline>
			// Mobile TOC accordion toggle
			const mobileToggle = document.querySelector('.mobile-toc-toggle');
			const mobileAccordion = document.querySelector('.mobile-toc-accordion');
			if (mobileToggle && mobileAccordion) {
				mobileToggle.addEventListener('click', () => {
					const isOpen = mobileAccordion.classList.toggle('open');
					mobileToggle.classList.toggle('open', isOpen);
					mobileToggle.setAttribute('aria-expanded', String(isOpen));
				});
			}

			// Close mobile accordion after TOC navigation
			document.addEventListener('click', (e) => {
				const link = e.target.closest('.toc-item a');
				if (!link) return;
				// Native anchor scrolling respects scroll-margin-top from CSS
				// No need for JS scrollIntoView — browser handles offset automatically
				if (mobileToggle && mobileAccordion) {
					mobileAccordion.classList.remove('open');
					mobileToggle.classList.remove('open');
					mobileToggle.setAttribute('aria-expanded', 'false');
				}
			});

			// Track banner clicks (GA4)
			function trackBannerClick(element) {
				if (typeof gtag === 'undefined') return;

				const bannerId = element.dataset.bannerId || 'unknown';
				const bannerName = element.dataset.bannerName || 'Unknown';
				const bannerLink = element.dataset.bannerLink || '';
				const category = document.querySelector('article')?.dataset.category || '';
				const lang = document.querySelector('html')?.lang || 'ru';
				const pathname = window.location.pathname;

				// Send event to GA4
				gtag('event', 'referral_banner_click', {
					event_category: 'referral',
					event_label: bannerName,
					banner_id: bannerId,
					banner_link: bannerLink,
					article_category: category,
					article_lang: lang,
					article_path: pathname,
					transport_type: 'beacon',
				});
				
				// Also track as outbound link
				gtag('event', 'click', {
					event_category: 'outbound',
					event_label: bannerLink,
					transport_type: 'beacon',
				});
			}

			// Interactive TOC Highlighting — обновляет активный пункт при скролле
			// rootMargin: учитывает высоту header (72px) + scroll-margin-top (120px)
			const observerOptions = {
				root: null,
				rootMargin: '-120px 0px -50% 0px',
				threshold: 0
			};

			let currentActiveLink = null;
			let rafId = null;

			const updateActiveLink = (id) => {
				if (rafId) {
					cancelAnimationFrame(rafId);
				}
				
				rafId = requestAnimationFrame(() => {
					// Ищем в десктопном TOC
					const activeLink = document.querySelector(`.toc-sticky .toc-item a[href="#${id}"]`);
					
					// Обновляем только если активная ссылка изменилась
					if (activeLink && activeLink !== currentActiveLink) {
						// Удаляем класс у предыдущей активной ссылки
						if (currentActiveLink) {
							currentActiveLink.classList.remove('active');
						}
						// Добавляем класс к новой активной ссылке
						activeLink.classList.add('active');
						currentActiveLink = activeLink;
					}
					
					rafId = null;
				});
			};

			const observer = new IntersectionObserver((entries) => {
				// Находим первый видимый заголовок (ближайший к верху viewport)
				const visibleHeaders = entries
					.filter(entry => entry.isIntersecting)
					.map(entry => ({
						element: entry.target,
						top: entry.boundingClientRect.top
					}))
					.sort((a, b) => a.top - b.top);

				if (visibleHeaders.length > 0) {
					const id = visibleHeaders[0].element.getAttribute('id');
					if (id) {
						updateActiveLink(id);
					}
				}
			}, observerOptions);

			// Observe all headers inside .prose
			document.querySelectorAll('.prose h2, .prose h3').forEach((header) => {
				observer.observe(header);
			});

			// SSR-rendered ad banner — minimal JS to move DOM node after 2nd H2
			const slot = document.getElementById('ad-banner-slot');
			if (slot) {
				const h2s = document.querySelectorAll('.prose-section h2');
				if (h2s.length >= 2) {
					const target = h2s[1].closest('.prose-section');
					if (target) {
						slot.style.display = 'block';
						target.after(slot);
					}
				} else {
					slot.style.display = 'block';
				}
			}
		</script>

		{/* GA4 tracking is initialized in Analytics.astro (imported via BaseHead) */}
