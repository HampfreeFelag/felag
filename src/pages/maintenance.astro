---
import BaseHead from '../components/BaseHead.astro';
import { ui } from '../i18n/ui';
---

<!doctype html>
<html lang="ru">
	<head>
		<BaseHead title="FÉLAG — Maintenance" description="System reboot in progress" />
	</head>
	<body>
		<main class="maintenance-wrapper">
			<div class="maintenance-card">
				<div class="maintenance-icon">
					<svg width="80" height="80" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
						<circle cx="12" cy="12" r="3"/>
						<path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/>
					</svg>
				</div>

				<div class="lang-block">
					<h1>{ui.ru['maintenance.title']}</h1>
					<p>{ui.ru['maintenance.message']}</p>
					<p class="subtitle">{ui.ru['maintenance.subtitle']}</p>
				</div>

				<div class="divider"></div>

				<div class="lang-block">
					<h1>{ui.en['maintenance.title']}</h1>
					<p>{ui.en['maintenance.message']}</p>
					<p class="subtitle">{ui.en['maintenance.subtitle']}</p>
				</div>

				<div class="maintenance-status">
					<span class="status-code">503 — SERVICE_UNAVAILABLE</span>
					<span class="status-msg">FÉLAG · System reboot in progress</span>
				</div>
			</div>
		</main>

<style>
			.maintenance-wrapper {
				min-height: 100vh;
				display: flex;
				align-items: center;
				justify-content: center;
				padding: 2rem;
				background: var(--color-bg);
			}

			.maintenance-card {
				max-width: 640px;
				width: 100%;
				padding: 3rem;
				background: var(--color-surface);
				border: 1px solid var(--color-border);
				border-radius: var(--radius-lg);
				box-shadow: 0 4px 24px rgba(0, 0, 0, 0.06);
			}

			.maintenance-icon {
				color: var(--color-accent);
				margin-bottom: 2rem;
				display: flex;
				justify-content: center;
				animation: spin 6s linear infinite;
			}

			@keyframes spin {
				from { transform: rotate(0deg); }
				to { transform: rotate(360deg); }
			}

			.lang-block {
				margin-bottom: 1.5rem;
			}

			.lang-block:last-of-type {
				margin-bottom: 0;
			}

			h1 {
				font-family: var(--font-sans);
				font-size: 1.1rem;
				font-weight: 700;
				line-height: 1.4;
				margin-bottom: 0.75rem;
				color: var(--color-accent);
				text-transform: uppercase;
				letter-spacing: 0.05em;
			}

			p {
				font-size: 0.95rem;
				margin-bottom: 0.5rem;
				color: var(--color-text-secondary);
				line-height: 1.6;
			}

			.subtitle {
				font-size: 0.85rem;
				color: var(--color-text-tertiary);
			}

			.divider {
				border-top: 1px solid var(--color-border-light);
				margin: 1.5rem 0;
			}

			.maintenance-status {
				display: flex;
				flex-direction: column;
				gap: 0.25rem;
				font-family: var(--font-mono);
				font-size: 0.75rem;
				color: var(--color-text-tertiary);
				background: var(--color-bg-subtle);
				padding: 1rem;
				border-radius: var(--radius-sm);
				border-left: 3px solid var(--cat-crew);
				margin-top: 2rem;
			}

			.status-code {
				color: var(--cat-crew);
				font-weight: 600;
			}

			@media (max-width: 768px) {
				.maintenance-card {
					padding: 1.5rem;
				}
				h1 {
					font-size: 1rem;
				}
			}
		</style>
	</body>
</html>
