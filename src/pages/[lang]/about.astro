---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import ExternalLink from '../../components/icons/ExternalLink.astro';
import { SITE_TITLE, SITE_TITLE_EN } from '../../consts';
import { ui } from '../../i18n/ui';
import { useTranslations, useTranslatedPath } from '../../i18n/utils';
import { getLinkAttrs } from '../../utils/link-utils';
import { getPartnerClickHandler } from '../../utils/analytics';

export async function getStaticPaths() {
  return [
    { params: { lang: 'ru' } },
    { params: { lang: 'en' } },
  ];
}

const { lang } = Astro.params;
const t = useTranslations(lang as keyof typeof ui);
const translatePath = useTranslatedPath(lang as keyof typeof ui);

const breadcrumbItems = [
	{ label: t('nav.about') }
];

// Link attributes (computed once, used in both languages)
const cloudtipsAttrs = getLinkAttrs('https://pay.cloudtips.ru/p/e1100774', true);
const cloudtipsOnlick = getPartnerClickHandler('cloudtips', 'https://pay.cloudtips.ru/p/e1100774');
const telegramAttrs = getLinkAttrs('https://t.me/Hampfree');
const telegramOnlick = getPartnerClickHandler('telegram', 'https://t.me/Hampfree');
---

<!doctype html>
<html lang={lang}>
	<head>
		<BaseHead title={`${lang === 'en' ? SITE_TITLE_EN : SITE_TITLE} - ${t('nav.about')}`} description={t('home.hero_description')} />
	</head>
	<body>
		<Header />
		<main class="container page-top-padding">
			<div class="saga-header">
				<Breadcrumb items={breadcrumbItems} />
				<h1 class="page-title">{t('about.title')}</h1>
			</div>

			<article class="prose fade-in">
				{lang === 'ru' ? (
					<>
						<p class="post-lead">
							<strong>FÉLAG</strong> — бортовой журнал торгового сообщества.
						</p>
						<p>
							Мы не продаём иллюзии и не обещаем гарантированной доходности. Мы фиксируем реальность: как устроены рынки, как работают стратегии и какие ошибки стоят за каждым убытком. Здесь нет гуру. Есть только данные, проверенные подходы и готовность делиться опытом без прикрас.
						</p>

						<h2 id="history-ru">Наша история</h2>
						<p>
							Проект родился из личного опыта. Путь начинался с традиционных рынков, затем был осознанный переход в криптосектор. Мы прошли через опыт убытков, перестройку системы и построение собственной методологии. FÉLAG — это результат этого пути. Каждый этап стал уроком, а каждый урок — материалом для наших статей и исследований.
						</p>

						<h2 id="principles-ru">Наши принципы</h2>
						<ul>
							<li><strong>Честность.</strong> Мы показываем не только прибыльные сделки, но и просадки. Ошибка — это часть системы.</li>
							<li><strong>Взаимопомощь.</strong> Сообщество строится на обмене опытом и аналитикой, а не на пустых спекуляциях.</li>
							<li><strong>Осознанность.</strong> Каждое решение подкреплено риск-менеджментом и логикой, а не эмоциями.</li>
							<li><strong>Долгосрочность.</strong> Мы строим фундамент и систему, а не гонимся за разовыми хайповыми возможностями.</li>
						</ul>

						<h2 id="support-ru">Варианты поддержки</h2>
						<p>
							FÉLAG — это независимая площадка, которая развивается за счёт прямых взаимодействий и партнёрств.
						</p>
						<ul>
							<li><strong>Партнёрские ссылки.</strong> В футере блога размещены ссылки на инструменты, которыми мы пользуемся сами (хостинг, VPS, инфраструктура). Если они окажутся вам полезны, мы получаем небольшое вознаграждение от сервиса.</li>
							<li>
								<strong>Прямая поддержка.</strong>
								<a href={cloudtipsAttrs.href} target={cloudtipsAttrs.target} rel={cloudtipsAttrs.rel} aria-label={cloudtipsAttrs.ariaLabel} class="external-link" onclick={cloudtipsOnlick}>
									CloudTips
									<ExternalLink />
								</a>
								, если материалы блога помогли вам избежать ошибок, сэкономить время или найти верное архитектурное решение.
							</li>
							<li>
								<strong>Криптовалюта (Rabby Wallet, EVM-сети).</strong>
								<div class="crypto-address-block" data-address="0xCf458A42031B904268516134A907060Cbf6e4B05" data-lang="ru">
									<code class="crypto-address">0xCf458A42031B904268516134A907060Cbf6e4B05</code>
									<span class="copy-feedback" hidden>Скопировано!</span>
									<button class="copy-btn" type="button" aria-label="Копировать адрес">
										<svg class="copy-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
									</button>
								</div>
								<p class="crypto-networks">
									<strong>Поддерживаемые сети:</strong> Ethereum, BNB Chain, Polygon, Arbitrum, Optimism, Avalanche и 63+ других EVM-совместимых сетей.
								</p>
								<p class="crypto-assets">
									<strong>Поддерживаемые активы:</strong> ETH, USDT (ERC20/BEP20), USDC, BNB, MATIC и др.
								</p>
								<div class="crypto-warning">
									<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
									Не отправляйте BTC, LTC, SOL и другие не-EVM монеты. Средства будут потеряны безвозвратно.
								</div>
							</li>
						</ul>

						<h2 id="resources-ru">Наши ресурсы</h2>
						<ul>
							<li><a href="https://t.me/felag_logbook_ru" target="_blank" rel="noopener noreferrer" class="external-link">Telegram (Логбук) <ExternalLink /></a></li>
							<li><a href="https://setka.ru/users/019d0ea4-3979-7d01-9f9b-2f985162c254" target="_blank" rel="noopener noreferrer" class="external-link">Setka (Профи) <ExternalLink /></a></li>
							<li><a href="https://vk.com/felag_haven" target="_blank" rel="noopener noreferrer" class="external-link">VK (Гавань) <ExternalLink /></a></li>
						</ul>

						<h2 id="contact-ru">Связаться</h2>
						<p>
							Партнёрства и предложения: <a href={telegramAttrs.href} target={telegramAttrs.target} rel={telegramAttrs.rel} aria-label={telegramAttrs.ariaLabel} class="external-link" onclick={telegramOnlick}>
								Hampfree
								<ExternalLink />
							</a> (Telegram)
						</p>

						<p class="about-final">
							FÉLAG — это живой организм. Мы не даём готовых ответов на все вопросы, но предоставляем инструменты и данные, чтобы вы могли уверенно идти своим путём.
						</p>

						<p class="about-disclaimer">
							Материалы носят исключительно образовательный характер и не являются индивидуальной инвестиционной рекомендацией.
						</p>
					</>
				) : (
					<>
						<p class="post-lead">
							<strong>FÉLAG</strong> — the logbook of a trading community.
						</p>
						<p>
							We do not sell illusions or promise guaranteed returns. We document reality: how markets work, how strategies perform, and the mistakes behind every loss. There are no gurus here. Only data, proven approaches, and a willingness to share experience without sugarcoating.
						</p>

						<h2 id="history-en">Our Story</h2>
						<p>
							The project was born from personal experience. The journey started in traditional markets, followed by a conscious transition to the crypto sector. We went through drawdowns, system restructuring, and the development of our own methodology. FÉLAG is the result of this path. Every stage became a lesson, and every lesson became material for our articles and research.
						</p>

						<h2 id="principles-en">Our Principles</h2>
						<ul>
							<li><strong>Honesty.</strong> We show not only profitable trades but also drawdowns. A mistake is part of the system.</li>
							<li><strong>Mutual Aid.</strong> The community is built on sharing experience and analytics, not empty speculation.</li>
							<li><strong>Mindfulness.</strong> Every decision is backed by risk management and logic, not emotions.</li>
							<li><strong>Long-term focus.</strong> We build a foundation and a system, rather than chasing one-off hype opportunities.</li>
						</ul>

						<h2 id="support-en">Support Options</h2>
						<p>
							FÉLAG is an independent platform that develops through direct interactions and partnerships.
						</p>
						<ul>
							<li>
								<strong>Partner Links:</strong>
								The blog footer contains links to tools we use ourselves (hosting, VPS, infrastructure). If you find them useful, we receive a small commission from the service.
							</li>
							<li>
								<strong>Direct Support:</strong>
								You can leave a tip via <a href={cloudtipsAttrs.href} target={cloudtipsAttrs.target} rel={cloudtipsAttrs.rel} aria-label={cloudtipsAttrs.ariaLabel} class="external-link" onclick={cloudtipsOnlick}>
									CloudTips
									<ExternalLink />
								</a> if the blog's materials helped you avoid mistakes, save time, or find the right architectural solution.
							</li>
							<li>
								<strong>Crypto (EVM networks):</strong>
								<div class="crypto-address-block" data-address="0xCf458A42031B904268516134A907060Cbf6e4B05" data-lang="en">
									<code class="crypto-address">0xCf458A42031B904268516134A907060Cbf6e4B05</code>
									<span class="copy-feedback" hidden>Copied!</span>
									<button class="copy-btn" type="button" aria-label="Copy address">
										<svg class="copy-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
									</button>
								</div>
								<p class="crypto-networks">
									<strong>Supported networks:</strong> Ethereum, BNB Chain, Polygon, Arbitrum, Optimism, Avalanche and 63+ other EVM-compatible networks.
								</p>
								<p class="crypto-assets">
									<strong>Supported assets:</strong> ETH, USDT (ERC20/BEP20), USDC, BNB, MATIC and more.
								</p>
								<div class="crypto-warning">
									<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
									Do not send BTC, LTC, SOL or other non-EVM coins. Funds will be permanently lost.
								</div>
							</li>
						</ul>

						<h2 id="resources-en">Our Resources</h2>
						<ul>
							<li><a href="https://t.me/felag_logbook_en" target="_blank" rel="noopener noreferrer" class="external-link">Telegram (Logbook) <ExternalLink /></a></li>
							<li><a href="https://felag.hashnode.dev" target="_blank" rel="noopener noreferrer" class="external-link">Hashnode (Haven) <ExternalLink /></a></li>
							<li><a href="https://dev.to/hampfree" target="_blank" rel="noopener noreferrer" class="external-link">Dev.to (Profi) <ExternalLink /></a></li>
						</ul>

						<h2 id="contact-en">Contact</h2>
						<p>
							Partnerships and proposals: <a href={telegramAttrs.href} target={telegramAttrs.target} rel={telegramAttrs.rel} aria-label={telegramAttrs.ariaLabel} class="external-link" onclick={telegramOnlick}>
								Hampfree
								<ExternalLink />
							</a> (Telegram)
						</p>

						<p class="about-final">
							FÉLAG is a living organism. We do not provide ready-made answers to all questions, but we supply the tools and data so you can confidently walk your own path.
						</p>

						<p class="about-disclaimer">
							All materials are for educational purposes only and do not constitute individual investment advice.
						</p>
					</>
				)}
			</article>
		</main>
		<Footer />
		<style>
			.page-title {
				word-break: break-word;
				line-height: 1.15;
			}
			.about-path {
				font-family: var(--font-mono);
				font-size: 0.9rem;
				color: var(--color-text-secondary);
				padding-left: var(--space-lg);
				border-left: 2px solid var(--color-amber);
			}
			blockquote footer {
				margin-top: 0.5rem;
				font-size: 0.9rem;
				font-style: normal;
				color: var(--color-text-tertiary);
			}
			.about-final {
				margin-top: var(--space-2xl);
			}
			.about-disclaimer {
				margin-top: var(--space-lg);
				font-size: 0.85rem;
				color: var(--color-text-tertiary);
				font-style: italic;
			}
			.support-btn {
				display: inline-flex;
				align-items: center;
				gap: var(--space-sm);
				padding: var(--space-md) var(--space-xl);
				font-family: var(--font-mono);
				font-size: 0.9rem;
				font-weight: 500;
				color: var(--color-bg);
				background: var(--color-accent);
				border: none;
				border-radius: var(--radius-sm);
				text-decoration: none;
				transition: background var(--duration-fast) var(--ease-out);
				cursor: pointer;
			}
			.support-btn:hover {
				background: var(--color-accent-hover);
			}
			/* Crypto address block */
			.crypto-address-block {
				display: flex;
				align-items: center;
				gap: 0.5rem;
				padding: var(--space-sm) var(--space-md);
				margin: var(--space-sm) 0;
				border: 1px solid var(--color-border);
				border-radius: var(--radius-sm);
				background: var(--color-bg-secondary);
				transition: border-color var(--duration-fast) var(--ease-out),
				            background var(--duration-fast) var(--ease-out);
				cursor: pointer;
				user-select: none;
			}
			.crypto-address-block:hover {
				border-color: var(--color-accent);
			}
			.crypto-address-block.copied {
				border-color: #22c55e;
				background: rgba(34, 197, 94, 0.1);
			}
			.crypto-address {
				font-family: 'JetBrains Mono', monospace;
				font-size: 0.85rem;
				color: var(--color-text-primary);
				word-break: break-all;
				overflow-wrap: break-word;
				flex: 1;
				min-width: 0;
			}
			.copy-btn {
				display: inline-flex;
				align-items: center;
				justify-content: center;
				padding: var(--space-xs);
				border: none;
				background: transparent;
				cursor: pointer;
				color: var(--color-text-secondary);
				transition: color var(--duration-fast) var(--ease-out);
				flex-shrink: 0;
			}
			.copy-btn:hover {
				color: var(--color-accent);
			}
			.copy-icon {
				width: 16px;
				height: 16px;
				flex-shrink: 0;
			}
			.copy-feedback {
				font-size: 0.8rem;
				color: #22c55e;
				white-space: nowrap;
				flex-shrink: 0;
			}
			.crypto-networks,
			.crypto-assets {
				font-size: 0.85rem;
				color: var(--color-text-secondary);
				margin: var(--space-xs) 0;
			}
			.crypto-networks strong,
			.crypto-assets strong {
				color: var(--color-text-primary);
			}
			.crypto-warning {
				display: flex;
				align-items: flex-start;
				gap: 0.5rem;
				padding: var(--space-sm);
				margin: var(--space-sm) 0;
				border: 1px solid var(--color-amber);
				border-radius: var(--radius-sm);
				background: var(--color-amber-light);
				font-size: 0.85rem;
				color: var(--color-text-primary);
				line-height: 1.5;
			}
			.crypto-warning svg {
				flex-shrink: 0;
				margin-top: 2px;
				color: var(--color-amber);
			}
			.crypto-warning strong {
				color: var(--color-amber);
			}
			@media (max-width: 768px) {
				.crypto-address {
					font-size: 0.75rem;
				}
			}
		</style>
		<script>
			if (typeof window !== 'undefined') {
				document.querySelectorAll('.crypto-address-block').forEach(block => {
					const address = block.dataset.address;
					const copyBtn = block.querySelector('.copy-btn');
					const feedback = block.querySelector('.copy-feedback');
					const isEn = block.dataset.lang === 'en';
					const feedbackText = isEn ? 'Copied!' : 'Скопировано!';
					
					block.addEventListener('click', async (e) => {
						if (e.target.closest('.copy-btn')) return;
						
						try {
							await navigator.clipboard.writeText(address);
							block.classList.add('copied');
							feedback.hidden = false;
							
							setTimeout(() => {
								block.classList.remove('copied');
								feedback.hidden = true;
							}, 2000);
						} catch {
							feedback.textContent = isEn ? 'Failed to copy' : 'Не удалось скопировать';
							feedback.hidden = false;
							setTimeout(() => {
								feedback.hidden = true;
								feedback.textContent = feedbackText;
							}, 2000);
						}
					});
					
					copyBtn.addEventListener('click', async (e) => {
						e.stopPropagation();
						
						try {
							await navigator.clipboard.writeText(address);
							block.classList.add('copied');
							feedback.hidden = false;
							
							setTimeout(() => {
								block.classList.remove('copied');
								feedback.hidden = true;
							}, 2000);
						} catch {
							feedback.textContent = isEn ? 'Failed to copy' : 'Не удалось скопировать';
							feedback.hidden = false;
							setTimeout(() => {
								feedback.hidden = true;
								feedback.textContent = feedbackText;
							}, 2000);
						}
					});
				});
			}
		</script>
	</body>
</html>
