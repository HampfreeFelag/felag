---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE_TITLE, SITE_TITLE_EN, SITE_DESCRIPTION, SITE_DESCRIPTION_EN } from '../../consts';
import FormattedDate from '../../components/FormattedDate.astro';
import ScrollTop from '../../components/ScrollTop.astro';
import Banner from '../../components/Banner.astro';
import { ui } from '../../i18n/ui';
import { useTranslations, useTranslatedPath } from '../../i18n/utils';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { isTempArticle } from '../../utils/blog';
import { CATEGORIES } from '../../config/categories';

export async function getStaticPaths() {
  return [
    { params: { lang: 'ru' } },
    { params: { lang: 'en' } },
  ];
}

const { lang } = Astro.params;
const t = useTranslations(lang as keyof typeof ui);
const translatePath = useTranslatedPath(lang as keyof typeof ui);

// Fetch only posts for current language
const collectionName = `blog-${lang}` as 'blog-ru' | 'blog-en';
const posts = await getCollection(collectionName).catch((err) => {
	console.error(`Error loading posts for ${collectionName}:`, err);
	return [];
});

// 🔒 ДЕДУПЛИКАЦИЯ: нормализуем post.id и убираем дубликаты
// post.id из Astro = "saga/crew/article-name/index.md" → "crew/article-name"
const normalizePostId = (id: string) => id
	.replace(/\/index$/, '')
	.replace(/\/+$/, '')
	.replace(/^saga\//, '');
const seenIds = new Set<string>();
const seenTitleCategory = new Set<string>();
const uniquePosts = posts.filter(post => {
	if (isTempArticle(post.id)) return false;
	if (post.data.draft) return false;
	
	const normalizedId = normalizePostId(post.id);
	const titleCategoryKey = `${post.data.title}|${post.data.category || ''}`;
	
	if (seenIds.has(normalizedId) || seenTitleCategory.has(titleCategoryKey)) {
		return false;
	}
	
	seenIds.add(normalizedId);
	seenTitleCategory.has(titleCategoryKey);
	Object.assign(post, { id: normalizedId });
	return true;
});

// ПОСЛЕДНИЕ_СТАТЬИ: pinned первыми, затем по pubDate
const sortedPosts = uniquePosts.sort((a, b) => {
	if (a.data.pinned && !b.data.pinned) return -1;
	if (!a.data.pinned && b.data.pinned) return 1;
	const byDate = b.data.pubDate.valueOf() - a.data.pubDate.valueOf();
	if (byDate !== 0) return byDate;
	return (a.id ?? '').localeCompare(b.id ?? '');
});
const featuredPosts = sortedPosts.slice(0, 4);

const categories = CATEGORIES.map((cat) => ({
	...cat,
	label: t(`cat.${cat.id}`),
	full: t(`cat.${cat.id}.full`),
}));

const breadcrumbItems: Array<{ label: string; href?: string }> = [];
---

<!doctype html>
<html lang={lang} data-astro-transition="slide">
	<head>
		<BaseHead 
			title={lang === 'en' ? SITE_TITLE_EN : SITE_TITLE} 
			description={lang === 'en' ? SITE_DESCRIPTION_EN : t('home.hero_description')} 
		/>
	</head>
	<body>
		<Header />
		<main class="container">
			<!-- Hero: editorial, типографика-first -->
			<section class="hero">
				<div class="hero-content">
					<h1>{t('home.hero_title')}</h1>
					<p>{t('home.hero_description')}</p>
					<div class="hero-actions">
						<a href={translatePath('saga')} class="text-link"><span>{t('home.hero_cta')}</span></a>
					</div>
				</div>
			</section>

			<!-- Categories Marquee -->
			<section aria-label={t('home.categories_label')} class="marquee-section">
				<div class="marquee-container">
					<div class="marquee-track">
					{categories.map(cat => (
						<a href={translatePath(`saga/?categories=${cat.id}`)} class="marquee-item">
							{cat.full}
						</a>
					))}
					{categories.map(cat => (
						<a href={translatePath(`saga/?categories=${cat.id}`)} class="marquee-item">
							{cat.full}
						</a>
					))}
					</div>
				</div>
			</section>

			<!-- Latest posts -->
			<section aria-labelledby="latest-label">
				<div id="latest-label" class="section-label">{t('home.latest_label')}</div>
				{featuredPosts.length > 0 ? (
					<div class="posts-grid">
						{featuredPosts.map(post => {
							const postCat = post.data.categories
								? post.data.categories[0]
								: post.data.category || '';
							return (
								<a href={translatePath(`saga/${post.id}`)} class="post-card" aria-label={`${t('saga.read_more')}: ${post.data.title}`}>
									<Banner 
										title={post.data.title} 
										subtitle={post.data.description}
										category={postCat} 
										type="preview" 
									/>
									<div class="post-meta">
										<span class="banner-date"><FormattedDate date={post.data.pubDate} /></span>
									</div>
									<div class="read-more-link" aria-hidden="true">{t('saga.read_more')}</div>
								</a>
							);
						})}
					</div>
				) : (
					<div style="padding: var(--space-2xl); text-align: center; color: var(--color-text-secondary);">
						<p>{t('library.no_articles')}</p>
					</div>
				)}
			</section>
		</main>
		<Footer />
		<ScrollTop />
	</body>
</html>
