---
// Global CSS must be imported as is:global to avoid Astro scoping.
// See: https://docs.astro.dev/en/reference/directives-reference/#style-isglobal
import type { ImageMetadata } from 'astro';
import { SITE_TITLE, SITE_DESCRIPTION, SEO_DESCRIPTION, SITE_VERSION } from '../consts';
import Analytics from './Analytics.astro';

interface Props {
	title: string;
	description?: string;
	metaOgTitle?: string; // OG заголовок для соцсетей (опционально, до 100 символов)
	image?: ImageMetadata | string;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const SUPPORTED_LANGS = ['ru', 'en'] as const;

// --- hreflang alternates (static hosting SEO hygiene) ---
const pathname = canonicalURL.pathname;
const pathParts = pathname.split('/').filter(Boolean);
const hasLangPrefix = pathParts.length > 0 && SUPPORTED_LANGS.includes(pathParts[0] as any);
const restParts = hasLangPrefix ? pathParts.slice(1) : pathParts;
const trailingSlash = pathname.endsWith('/');

const buildLangPath = (lang: (typeof SUPPORTED_LANGS)[number]) => {
	const rest = restParts.length ? restParts.join('/') : '';
	if (!rest) return `/${lang}/`;
	return `/${lang}/${rest}${trailingSlash ? '/' : ''}`;
};

const { title, description: descriptionProp, metaOgTitle, image: imageProp } = Astro.props;

// Автоматическая генерация description, если не указан
const description = descriptionProp || SITE_DESCRIPTION;

// Используем metaOgTitle для OG тегов, если указан, иначе используем title
const ogTitle = metaOgTitle || title;

// Определяем путь к OG изображению
// Приоритет: 1) явно указанное изображение, 2) автоматически сгенерированное OG изображение, 3) fallback
let ogImageUrl: URL;

if (imageProp) {
	// Если изображение явно указано, используем его
	if (typeof imageProp === 'string') {
		let imagePath = imageProp;
		if (imagePath.startsWith('./')) {
			imagePath = imagePath.slice(2);
		}
		if (imagePath.startsWith('/')) {
			ogImageUrl = new URL(imagePath, Astro.site);
		} else {
			const currentPath = Astro.url.pathname.endsWith('/') ? Astro.url.pathname.slice(0, -1) : Astro.url.pathname;
			ogImageUrl = new URL(currentPath + '/' + imagePath, Astro.site);
		}
	} else {
		// ImageMetadata
		ogImageUrl = new URL(imageProp.src, Astro.site);
	}
} else {
	// Автоматически определяем путь к сгенерированному OG изображению
	const pathname = Astro.url.pathname;
	const pathParts = pathname.split('/').filter(Boolean);
	const langPrefix = pathParts.length > 0 && SUPPORTED_LANGS.includes(pathParts[0] as any) ? pathParts[0] : 'ru';

	// Проверяем, это статья (saga/[lang]/[...slug]) или главная
	if (pathname.includes('/saga/')) {
		const sagaIndex = pathParts.indexOf('saga');
		if (sagaIndex >= 0) {
			const lang = pathParts[sagaIndex - 1] || langPrefix;
			const slugParts = pathParts.slice(sagaIndex + 1);
			const slug = slugParts.length > 0 ? slugParts.join('-') : 'homepage';
			ogImageUrl = new URL(`/og/${lang}-${slug}.png`, Astro.site);
		} else {
			ogImageUrl = new URL(FallbackImage.src, Astro.site);
		}
	} else if (pathname === '/' || pathname === '/ru/' || pathname === '/en/') {
		// Главная страница (мультиязычная)
		ogImageUrl = new URL(`/og/${langPrefix}-homepage.png`, Astro.site);
	} else if (pathname.includes('/about/')) {
		// Страница "О проекте" (мультиязычная)
		ogImageUrl = new URL(`/og/${langPrefix}-about.png`, Astro.site);
	} else {
		// Fallback для других страниц — используем логотип
		ogImageUrl = new URL("/felag-logo.png", Astro.site);
	}
}
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<meta name="astro-view-transitions-enabled" content="true" />

<!-- Theme: prevent FOUC — runs before any paint -->
<script is:inline>
	(function() {
		try {
			var saved = localStorage.getItem('felag_theme');
			var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
			if (saved === 'dark' || (!saved && prefersDark)) {
				document.documentElement.setAttribute('data-theme', 'dark');
			}
		} catch(e) {}
	})();
</script>

<!-- Google Fonts: Cormorant Garamond (headings) + Inter (body) + JetBrains Mono (code) -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600;700&family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;700&display=swap" rel="stylesheet" />

<!-- Preload critical fonts to reduce FOIT -->
<link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600;700&family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;700&display=swap" />

<!-- Favicon: PNG logo (browser scales automatically) -->
<link rel="icon" type="image/png" href={`${new URL("/felag-logo.png", Astro.site).href}?v=${SITE_VERSION}`} sizes="any" />
<link rel="apple-touch-icon" href={`${new URL("/felag-logo.png", Astro.site).href}?v=${SITE_VERSION}`} />
<link rel="manifest" href={`${new URL("/site.webmanifest", Astro.site).href}?v=${SITE_VERSION}`} />

<meta name="generator" content={Astro.generator} />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Alternate Language Links (SEO) -->
{SUPPORTED_LANGS.map((l) => (
	<link rel="alternate" hreflang={l} href={new URL(buildLangPath(l), Astro.site)} />
))}

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={ogTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImageUrl} />

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={Astro.url} />
<meta property="twitter:title" content={ogTitle} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={ogImageUrl} />

<script is:inline>
	try {
		const l = document.documentElement.lang;
		if (l && ['ru', 'en'].includes(l)) {
			localStorage.setItem('ml_lang', l);
		}
	} catch {}
</script>

<!-- JSON-LD Structured Data (Organization + WebSite) -->
{(() => {
	const siteUrl = Astro.site || "https://felag.online";
	const orgSchema = {
		"@context": "https://schema.org",
		"@type": "Organization",
		"name": "FÉLAG",
		"url": siteUrl.href,
		"logo": {
			"@type": "ImageObject",
			"url": new URL("/logo.svg", siteUrl).href
		},
		"description": SITE_DESCRIPTION,
		"sameAs": [
			"https://t.me/Hampfree"
		]
	};
	const websiteSchema = {
		"@context": "https://schema.org",
		"@type": "WebSite",
		"name": "FÉLAG",
		"url": siteUrl.href,
		"description": SITE_DESCRIPTION,
		"inLanguage": ["ru", "en"],
		"potentialAction": {
			"@type": "SearchAction",
			"target": "{siteUrl.href}{lang}/saga/?q={search_term_string}",
			"query-input": "required name=search_term_string"
		}
	};
	const orgJson = JSON.stringify(orgSchema, null, 0);
	const websiteJson = JSON.stringify(websiteSchema, null, 0);
	return <>
		<script type="application/ld+json" set:html={orgJson} />
		<script type="application/ld+json" set:html={websiteJson} />
	</>;
})()}

<!-- Analytics -->
<Analytics />

<style is:global>
  @import '../styles/global.css';
</style>
