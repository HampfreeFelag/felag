---
// Переиспользуемый компонент реферального баннера
// Реклама рендерится только с erid (38-ФЗ); внутренние (internal) — всегда.
// 38-ФЗ: плашка «Реклама» + рекламодатель + erid — обязательны.

import type { AdBanner } from '../config/ad-banners';

export interface Props {
  banner: AdBanner;
  lang?: 'ru' | 'en';
  className?: string;
}

const { banner, lang = 'ru', className = '' } = Astro.props;

// Реклама без erid не публикуется (38-ФЗ)
if (!banner.internal && !banner.erid) {
  console.warn(`[BannerCard] ${banner.id}: скрыт — отсутствует erid (38-ФЗ)`);
}

// Формируем финальную ссылку
const finalLink = banner.link.startsWith('/')
  ? banner.link.replace('{lang}', lang)
  : banner.link;

const isAd = !banner.internal;
const adMark = isAd && banner.erid
  ? `Реклама · ${banner.advertiser?.name || ''} · erid: ${banner.erid}`
  : '';
---

{isAd && !banner.erid ? null : (
<div class={`ad-banner-container ${className}`}>
  <a
    href={finalLink}
    target={isAd ? '_blank' : undefined}
    rel={isAd ? 'nofollow sponsored' : undefined}
    class="ad-banner-link"
    style={{
      '--bg-start': banner.colors.bgStart,
      '--bg-end': banner.colors.bgEnd,
      '--text-color': banner.colors.text,
      '--cta-bg': banner.colors.ctaBg,
      '--cta-text': banner.colors.ctaText,
      '--border-color': banner.colors.border,
    }}
  >
    <div class="ad-banner-content">
      <div class="text-block">
        <h3 class="ad-banner-title">{banner.title}</h3>
        <p class="ad-banner-subtitle">{banner.subtitle}</p>
      </div>
      <span class="ad-banner-cta">{banner.cta}</span>
    </div>
  </a>
  {adMark && <div class="ad-banner-mark">{adMark}</div>}
</div>
)}

<style>
  .ad-banner-container {
    width: 100%;
    max-width: 800px;
    margin: 2.5rem auto;
    padding: 0;
  }

  .ad-banner-link {
    display: block;
    background: linear-gradient(135deg, var(--bg-start), var(--bg-end));
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md, 4px);
    padding: 20px 24px;
    text-decoration: none !important;
    transition: opacity 0.15s ease;
  }

  .ad-banner-link:hover {
    opacity: 0.92;
    text-decoration: none !important;
  }

  .ad-banner-content {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .ad-banner-title {
    font-family: var(--font-serif, serif);
    font-size: 1.35rem;
    font-weight: 600;
    color: var(--text-color);
    margin: 0 0 0.35rem 0;
    line-height: 1.3;
  }

  .ad-banner-subtitle {
    font-family: var(--font-mono, monospace);
    font-size: 0.85rem;
    color: var(--text-color);
    opacity: 0.85;
    margin: 0;
    line-height: 1.5;
  }

  .ad-banner-cta {
    font-family: var(--font-mono, monospace);
    font-size: 0.8rem;
    font-weight: 500;
    background: var(--cta-bg);
    color: var(--cta-text);
    padding: 0.55rem 1.1rem;
    border-radius: var(--radius-sm, 3px);
    white-space: nowrap;
  }

  .ad-banner-mark {
    margin-top: 6px;
    font-family: var(--font-mono, monospace);
    font-size: 0.7rem;
    color: var(--color-text-tertiary, #9B968B);
    text-align: center;
    user-select: text;
  }

  @media (max-width: 768px) {
    .ad-banner-container {
      margin: 2rem auto;
    }

    .ad-banner-content {
      flex-direction: column;
      align-items: flex-start;
    }

    .ad-banner-cta {
      align-self: stretch;
      text-align: center;
    }
  }
</style>
