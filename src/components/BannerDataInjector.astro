---
// BannerDataInjector.astro
// Вставляет JSON-объект в <script> для window.BANNER_DATA.

import { BANNER_TRANSLATIONS } from '../config/ad-banners';

const bannerDataJson = JSON.stringify(BANNER_TRANSLATIONS, null, 0);
---

<script type="application/json" id="banner-data-json">{bannerDataJson}</script>

<script>
  const jsonEl = document.getElementById('banner-data-json');
  if (jsonEl) {
    (window as any).BANNER_DATA = JSON.parse(jsonEl.textContent || '{}');
  }
</script>
