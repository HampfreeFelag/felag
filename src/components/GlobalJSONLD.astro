---
import { SITE_DESCRIPTION } from '../consts';
---

<!-- Organization + WebSite — общие данные, генерируются ОДИН раз на страницу -->
<script type="application/ld+json">
{JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "FÉLAG",
  "url": Astro.site?.href || "https://felag.online",
  "logo": {
    "@type": "ImageObject",
    "url": new URL("/logo.svg", Astro.site || "https://felag.online").href
  },
  "description": SITE_DESCRIPTION,
  "sameAs": ["https://t.me/Hampfree"]
}, null, 0)}
</script>

<script type="application/ld+json">
{JSON.stringify({
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "FÉLAG",
  "url": Astro.site?.href || "https://felag.online",
  "description": SITE_DESCRIPTION,
  "inLanguage": ["ru", "en"],
  "potentialAction": {
    "@type": "SearchAction",
    "target": "{Astro.site?.href}{lang}/saga/?q={search_term_string}",
    "query-input": "required name=search_term_string"
  }
}, null, 0)}
</script>
