---
import { SITE_DESCRIPTION, SITE_DESCRIPTION_EN } from '../consts';

const langPrefix = Astro.url.pathname.split('/')[1] || 'ru';

const orgJson = JSON.stringify({
	"@context": "https://schema.org",
	"@type": "Organization",
	"name": "FÉLAG",
	"url": Astro.site?.href || "https://felag.online",
	"logo": {
		"@type": "ImageObject",
		"url": new URL("/logo.svg", Astro.site || "https://felag.online").href
	},
	"description": langPrefix === 'en' ? SITE_DESCRIPTION_EN : SITE_DESCRIPTION,
	"sameAs": ["https://t.me/Hampfree"]
}, null, 0);

const websiteJson = JSON.stringify({
	"@context": "https://schema.org",
	"@type": "WebSite",
	"name": "FÉLAG",
	"url": Astro.site?.href || "https://felag.online",
	"description": langPrefix === 'en' ? SITE_DESCRIPTION_EN : SITE_DESCRIPTION,
	"inLanguage": ["ru", "en"],
	"potentialAction": {
		"@type": "SearchAction",
		"target": `${Astro.site?.href}${langPrefix}/saga/?q={search_term_string}`,
		"query-input": "required name=search_term_string"
	}
}, null, 0);
---

<!-- Organization + WebSite — общие данные, генерируются ОДИН раз на страницу -->
<script type="application/ld+json" set:html={orgJson} />
<script type="application/ld+json" set:html={websiteJson} />
