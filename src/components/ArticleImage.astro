---
import { getImage } from 'astro:assets';

interface Props {
  src: string | any;
  alt: string;
  width?: number;
  height?: number;
  class?: string;
}

const { src, alt, width: propWidth, height: propHeight, class: className = '' } = Astro.props;

if (!alt || alt.trim() === '') {
  throw new Error(`ArticleImage: атрибут 'alt' обязателен. Изображение: ${src}`);
}

const isImportedAsset = typeof src === 'object' && src !== null;

// Get natural dimensions
const naturalWidth = propWidth || (isImportedAsset ? (src.width ?? 1600) : 1600);
const naturalHeight = propHeight || (isImportedAsset ? (src.height ?? 900) : 900);
const aspectRatio = `${naturalWidth} / ${naturalHeight}`;

// Generate srcset manually with known widths
let srcset = '';
let optimizedSrc = '';

if (isImportedAsset) {
  const sizes = [
    { w: 640, label: 'sm' },
    { w: 1024, label: 'md' },
    { w: 1600, label: 'lg' },
  ];

  const srcsetParts = [];
  let mainSrc = '';

  for (const { w } of sizes) {
    if (w > naturalWidth) continue;
    try {
      const optimized = await getImage({
        src,
        width: w,
        height: Math.round(w * (naturalHeight / naturalWidth)),
        format: 'webp',
      });
      if (optimized && optimized.src) {
        srcsetParts.push(`${optimized.src} ${w}w`);
        mainSrc = optimized.src;
      }
    } catch {}
  }

  srcset = srcsetParts.join(', ');
  optimizedSrc = mainSrc;
}
---

<figure style={`aspect-ratio: ${aspectRatio}`} class:list={['article-image-wrapper', className].filter(Boolean)}>
  {isImportedAsset && optimizedSrc ? (
    <img
      src={optimizedSrc}
      srcset={srcset}
      sizes="(max-width: 768px) 100vw, 680px"
      alt={alt}
      width={naturalWidth}
      height={naturalHeight}
      loading="lazy"
      decoding="async"
      class="article-image"
    />
  ) : (
    <img
      src={typeof src === 'object' ? (src.src || src) : src}
      alt={alt}
      width={propWidth}
      height={propHeight}
      loading="lazy"
      decoding="async"
      class="article-image"
    />
  )}

  <slot>
    {alt && <figcaption class="article-image-caption">{alt}</figcaption>}
  </slot>

  <button
    class="lightbox-trigger"
    aria-label={`Увеличить изображение: ${alt}`}
    data-src={isImportedAsset ? (typeof src === 'object' ? (src.src || src) : src) : src}
  >
    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line><line x1="11" y1="8" x2="11" y2="14"></line><line x1="8" y1="11" x2="14" y2="11"></line></svg>
  </button>
</figure>

<div class="article-image-lightbox" role="dialog" aria-modal="true" aria-label="Просмотр изображения" hidden>
  <div class="lightbox-backdrop"></div>
  <div class="lightbox-content">
    <button class="lightbox-close" aria-label="Закрыть изображение">&times;</button>
    <img src="" alt="" class="lightbox-img" />
  </div>
</div>

<style>
  .article-image-wrapper {
    position: relative;
    margin: clamp(16px, 4vw, 32px) auto;
    max-width: 100%;
    text-align: center;
  }
  .article-image {
    max-width: 100%;
    height: auto;
    border-radius: var(--radius-md, 8px);
    transition: filter 0.2s ease;
    box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1), 0 2px 4px -1px rgba(0,0,0,0.06);
    display: block;
    margin: 0 auto;
  }
  .article-image-wrapper:hover .article-image { filter: brightness(0.95); }
  .article-image-caption {
    margin-top: 8px;
    font-size: 0.875rem;
    color: var(--text-muted, #6b7280);
    text-align: center;
  }
  .lightbox-trigger {
    position: absolute; top: 8px; right: 8px;
    background: rgba(0,0,0,0.6); color: white; border: none;
    border-radius: 50%; width: 32px; height: 32px;
    display: flex; align-items: center; justify-content: center;
    cursor: pointer; opacity: 0; transition: opacity 0.2s ease; z-index: 10;
  }
  .article-image-wrapper:hover .lightbox-trigger,
  .lightbox-trigger:focus { opacity: 1; }
  .lightbox-trigger:focus {
    outline: 2px solid var(--primary-color, #3b82f6); outline-offset: 2px;
  }
  .article-image-lightbox {
    position: fixed; inset: 0; z-index: 9999;
    display: flex; align-items: center; justify-content: center;
  }
  .article-image-lightbox[hidden] { display: none; }
  .lightbox-backdrop {
    position: absolute; inset: 0;
    background: rgba(0,0,0,0.85); backdrop-filter: blur(4px);
  }
  .lightbox-content { position: relative; max-width: 90vw; max-height: 90vh; z-index: 10000; }
  .lightbox-img {
    max-width: 100%; max-height: 85vh; object-fit: contain;
    border-radius: var(--radius-md, 8px);
    box-shadow: 0 20px 25px -5px rgba(0,0,0,0.5);
  }
  .lightbox-close {
    position: absolute; top: -40px; right: 0;
    background: transparent; color: white; border: none;
    font-size: 2rem; cursor: pointer; line-height: 1;
  }
  .lightbox-close:focus { outline: 2px solid white; outline-offset: 4px; }
  @media (max-height: 500px) { .lightbox-img { max-height: 80vh; } }
  @media (prefers-reduced-motion: reduce) {
    .article-image, .lightbox-trigger, .lightbox-backdrop { transition: none; }
  }
</style>

<script>
  document.querySelectorAll('.article-image-wrapper').forEach(wrapper => {
    const trigger = wrapper.querySelector('.lightbox-trigger');
    const lightbox = wrapper.querySelector('.article-image-lightbox');
    const lightboxImg = lightbox.querySelector('.lightbox-img');
    const closeBtn = lightbox.querySelector('.lightbox-close');
    const backdrop = lightbox.querySelector('.lightbox-backdrop');
    let lastFocusedElement = null;

    const openLightbox = () => {
      lastFocusedElement = document.activeElement;
      lightboxImg.src = trigger.getAttribute('data-src');
      lightboxImg.alt = (trigger.getAttribute('aria-label') || '').replace('Увеличить изображение: ', '');
      lightbox.removeAttribute('hidden');
      document.body.style.overflow = 'hidden';
      closeBtn.focus();
      document.addEventListener('keydown', handleKeydown);
      backdrop.addEventListener('click', closeLightbox);
    };
    const closeLightbox = () => {
      lightbox.setAttribute('hidden', '');
      document.body.style.overflow = '';
      document.removeEventListener('keydown', handleKeydown);
      backdrop.removeEventListener('click', closeLightbox);
      if (lastFocusedElement) lastFocusedElement.focus();
    };
    const handleKeydown = (e) => { if (e.key === 'Escape') closeLightbox(); };

    trigger.addEventListener('click', openLightbox);
    closeBtn.addEventListener('click', closeLightbox);
  });
</script>
