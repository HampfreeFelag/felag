---
// Footer — 3-column layout with strict language segregation
import ConsentBanner from './ConsentBanner.astro';
import ExternalLink from './icons/ExternalLink.astro';
import { getLangFromUrl, useTranslations, useTranslatedPath } from '../i18n/utils';
import { getLinkAttrs } from '../utils/link-utils';
import { getPartnerClickHandler } from '../utils/analytics';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
const today = new Date();
const pathname = Astro.url.pathname;

// Article pages get partners + ERID; service pages get minimal footer only
const isArticlePage = pathname.includes('/saga/') && !pathname.includes('/saga/index');

// ERID tokens (38-ФЗ marking)
// RU: all 4 partners | EN: only Veles
const PARTNERS = lang === 'en'
  ? [
      {
        id: 'veles',
        name: t('footer.veles'),
        href: 'https://veles.finance/invite/washmallay',
        erid: 'CQH36pWzJqVKznERGZtWRYzjm6yPFbxFKEnry3zcBHeD37',
        advertiser: 'OOO "VELES.FINANCE"',
        inn: '9725074398',
      },
    ]
  : [
      {
        id: 'veles',
        name: t('footer.veles'),
        href: 'https://veles.finance/invite/washmallay',
        erid: 'CQH36pWzJqVKznERGZtWRYzjm6yPFbxFKEnry3zcBHeD37',
        advertiser: 'ООО «ВЕЛЕС.ФИНАНС»',
        inn: '9725074398',
      },
      {
        id: 'kvmka',
        name: t('footer.kvmka'),
        href: 'https://kvmka.ru/?from=23600',
        erid: 'CQH36pWzJqVKznERMApgkbu1yZRi4eK158Cu3G65GNbqPF',
        advertiser: 'ООО «Алекс Групп»',
        inn: '5040109853',
      },
      {
        id: 'tbank',
        name: t('footer.tbank'),
        href: 'https://tbank-online.com/baf/2z9xz0ZejZr',
        erid: 'CQH36pWzJqVKznERQSL5xgCvKRJzmsR2PAxxaFmiaN1y77',
        advertiser: 'АО «Т-Банк»',
        inn: '7706188893',
      },
      {
        id: 'regru',
        name: t('footer.reg_ru'),
        href: 'https://www.reg.ru/?rlink=reflink-32593309',
        erid: 'CQH36pWzJqVKznERH83R6V9PGJk6Nw97r3FepZSpTSSnud',
        advertiser: 'ООО «РЕГ.РУ»',
        inn: '7710655749',
      },
    ];

const CLOUDTIPS = {
  name: t('footer.cloudtips'),
  href: 'https://pay.cloudtips.ru/p/e1100774',
};

// Resources links — sorted by name length (longest first)
const RESOURCES_RU = [
  { name: t('footer.telegram'), href: 'https://t.me/felag_logbook_ru' },
  { name: t('footer.setka'), href: 'https://setka.ru/users/019d0ea4-3979-7d01-9f9b-2f985162c254' },
  { name: t('footer.vk'), href: 'https://vk.com/felag_haven' },
];

const RESOURCES_EN = [
  { name: t('footer.hashnode'), href: 'https://felag.hashnode.dev' },
  { name: t('footer.telegram'), href: 'https://t.me/felag_logbook_en' },
  { name: t('footer.devto'), href: 'https://dev.to/hampfree' },
];

// Support links — sorted by name length (longest first)
const SUPPORT_RU = [
  { name: t('footer.rabby'), href: '#', external: false },
  { name: t('footer.cloudtips'), href: CLOUDTIPS.href },
];
---

<footer class="main-footer">
	<div class="container">
		<!-- FULL FOOTER: only on article pages -->
		{isArticlePage && (
			<>
				<!-- 3-column grid -->
				<div class="footer-grid">
					<!-- Column 1: Resources -->
					<div class="footer-column">
						<h3 class="footer-column-title">{t('footer.resources_title')}</h3>
						<ul class="footer-resource-list">
							{lang === 'ru' ? (
								RESOURCES_RU.map(r => {
									const attrs = getLinkAttrs(r.href, true);
									return (
										<li class="footer-resource-item">
											<a href={attrs.href} target={attrs.target} rel={attrs.rel} class="footer-resource-link external-link">
												<span>{r.name}</span>
												<ExternalLink />
											</a>
										</li>
									);
								})
							) : (
								RESOURCES_EN.map(r => {
									const attrs = getLinkAttrs(r.href, true);
									return (
										<li class="footer-resource-item">
											<a href={attrs.href} target={attrs.target} rel={attrs.rel} class="footer-resource-link external-link">
												<span>{r.name}</span>
												<ExternalLink />
											</a>
										</li>
									);
								})
							)}
						</ul>
					</div>

					<!-- Column 2: Tools / Partners -->
					<div class="footer-column">
						<h3 class="footer-column-title">{t('footer.tools_title')}</h3>
						<ul class="footer-partner-list">
							{PARTNERS.map(p => {
								const attrs = getLinkAttrs(p.href, true);
								const onclick = getPartnerClickHandler(p.id, p.href);
								return (
									<li class="footer-partner-item">
										<a href={attrs.href} target={attrs.target} rel={attrs.rel} aria-label={attrs.ariaLabel} class="footer-partner-link external-link" onclick={onclick}>
											<span class="partner-name">{p.name}</span>
											<ExternalLink />
										</a>
									</li>
								);
							})}
						</ul>
					</div>

					<!-- Column 3: Support (RU only — CloudTips is a Russian service) -->
					{lang === 'ru' && (
						<div class="footer-column footer-column-support">
							<h3 class="footer-column-title">{t('footer.support_title')}</h3>
							<ul class="footer-support-list">
								<li class="footer-support-item">
									<a href="#" class="footer-support-link external-link" target="_blank" rel="noopener noreferrer">
										<span class="support-name">{t('footer.rabby')}</span>
										<ExternalLink />
									</a>
								</li>
								<li class="footer-support-item">
									{(() => {
										const attrs = getLinkAttrs(CLOUDTIPS.href, true);
										const onclick = getPartnerClickHandler('cloudtips', CLOUDTIPS.href);
										return (
											<a href={attrs.href} target={attrs.target} rel={attrs.rel} aria-label={attrs.ariaLabel} class="footer-support-link external-link" onclick={onclick}>
												<span class="support-name">{CLOUDTIPS.name}</span>
												<ExternalLink />
											</a>
										);
									})()}
								</li>
							</ul>
						</div>
					)}
				</div>

				<!-- Legal info (ERID markings) -->
				<div class="footer-legal">
					{PARTNERS.map(p => (
						<p class="footer-legal-item">
							{t('footer.ad_marking')}. {p.advertiser}, ИНН {p.inn}. erid: {p.erid}
						</p>
					))}
				</div>
			</>
		)}

		<!-- Copyright (always shown) -->
		<div class="footer-bottom">
			<p class="footer-copy">&copy; {today.getFullYear()} FÉLAG. {t('footer.rights')} · <a href={translatePath('privacy')}>{t('nav.privacy')}</a></p>
		</div>
	</div>
</footer>

<style>
	/* ── Footer Grid — 3 columns ── */
	.footer-grid {
		max-width: var(--max-width);
		margin: 0 auto var(--space-xl);
		padding: 0 var(--page-padding);
		display: grid;
		grid-template-columns: 1fr 1fr 1fr;
		gap: var(--space-2xl) var(--space-3xl);
	}

	.footer-column-title {
		font-size: 0.75rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		color: var(--color-text-tertiary);
		margin: 0 0 var(--space-lg) 0;
	}

	/* ── Shared list styles ── */
	.footer-resource-list,
	.footer-partner-list,
	.footer-support-list {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: var(--space-md);
	}

	.footer-resource-item,
	.footer-partner-item,
	.footer-support-item {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
	}

	/* ── Resource links ── */
	.footer-resource-link {
		display: inline-flex;
		flex-direction: row;
		align-items: center;
		gap: 0.4rem;
		text-decoration: none;
		cursor: pointer;
		color: var(--color-text);
		font-size: 0.9rem;
		font-weight: 500;
		transition: color var(--duration-fast) var(--ease-out);
	}

	.footer-resource-link:hover {
		color: var(--color-accent-hover);
	}

	/* ── Partner links ── */
	.footer-partner-link {
		display: inline-flex;
		flex-direction: row;
		align-items: center;
		gap: 0.4rem;
		text-decoration: none;
		cursor: pointer;
		color: var(--color-text);
		transition: color var(--duration-fast) var(--ease-out);
	}

	.footer-partner-link:hover {
		color: var(--color-accent-hover);
	}

	.partner-name {
		font-size: 0.9rem;
		font-weight: 500;
		color: var(--color-accent);
	}

	/* ── Support links ── */
	.footer-column-support {
		border-left: 1px solid var(--color-border-light);
		padding-left: var(--space-xl);
	}

	.footer-support-link {
		display: inline-flex;
		flex-direction: row;
		align-items: center;
		gap: 0.4rem;
		text-decoration: none;
		cursor: pointer;
		color: var(--color-accent);
		font-size: 0.9rem;
		font-weight: 500;
		transition: color var(--duration-fast) var(--ease-out);
	}

	.footer-support-link:hover {
		color: var(--color-accent-hover);
	}

	.support-name {
		font-size: 0.9rem;
		font-weight: 500;
		color: var(--color-accent);
	}

	/* ── Legal info (consolidated ERID) ── */
	.footer-legal {
		border-top: 1px solid var(--color-border-light);
		padding-top: var(--space-md);
		padding-bottom: var(--space-xl);
		margin-top: var(--space-lg);
		margin-bottom: var(--space-md);
		display: flex;
		flex-direction: column;
		gap: 0.15rem;
	}

	.footer-legal-item {
		font-size: 0.6rem;
		color: #9B968B;
		line-height: 1.3;
		margin: 0;
	}

	/* ── Bottom (copyright) ── */
	.footer-bottom {
		border-top: 1px solid var(--color-border-light);
		padding-top: var(--space-lg);
		padding-bottom: var(--space-xl);
	}

	.footer-copy {
		font-size: 0.8rem;
		color: var(--color-text-tertiary);
		margin: 0;
		text-align: center;
	}

	.footer-copy a {
		color: var(--color-text-secondary);
	}

	.footer-copy a:hover {
		color: var(--color-text);
	}

	/* ── Mobile ── */
	@media (max-width: 767px) {
		.footer-grid {
			grid-template-columns: 1fr;
			gap: var(--space-xl);
		}

		.footer-column-support {
			border-left: none;
			border-top: 1px solid var(--color-border-light);
			padding-left: 0;
			padding-top: var(--space-lg);
		}

		.footer-legal {
			padding-bottom: var(--space-lg);
		}

		.footer-bottom {
			padding-bottom: var(--space-xl);
		}
	}

	/* ── Large screens ── */
	@media (min-width: 1440px) {
		.footer-legal {
			padding-bottom: var(--space-2xl);
		}

		.footer-bottom {
			padding-bottom: var(--space-3xl);
		}
	}
</style>

<ConsentBanner />
