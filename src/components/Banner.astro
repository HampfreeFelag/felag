---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

interface Props {
	title: string;
	subtitle?: string;
	category?: string;
	type?: 'preview' | 'full';
	className?: string;
}

const { 
	title, 
	subtitle = '', 
	category = '',
	type = 'preview',
	className = '' 
} = Astro.props;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const cleanSubtitle = subtitle?.endsWith('.') ? subtitle.slice(0, -1) : subtitle;

const rawCat = category?.toLowerCase().trim();
const rubric = rawCat ? (t(`cat.${rawCat}` as any) || rawCat) : '';

// На полной странице статьи заголовок — h1 (единственный на странице),
// в превью/списках — h2, чтобы не ломать иерархию заголовков
const TitleTag = type === 'full' ? 'h1' : 'h2';

// Category color class
const catClass = rawCat === 'route' ? 'cat-route' :
                 rawCat === 'forge' ? 'cat-forge' :
                 rawCat === 'helm' ? 'cat-helm' :
                 rawCat === 'treasury' ? 'cat-treasury' :
                 rawCat === 'compass' ? 'cat-compass' :
                 rawCat === 'logbook' ? 'cat-logbook' :
                 rawCat === 'crew' ? 'cat-crew' : '';
---

<div class={`banner banner--${type} ${className}`}>
	<div class="banner-inner">
		<div class="banner-top">
			{rubric && <span class={`banner-rubric ${catClass}`}>{rubric}</span>}
			{title && <TitleTag class="banner-title">{title}</TitleTag>}
			{cleanSubtitle && <p class="banner-subtitle">{cleanSubtitle}</p>}
		</div>
	</div>
</div>
