---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

interface Props {
	title: string;
	subtitle?: string;
	category?: string;
	type?: 'preview' | 'full';
	className?: string;
}

const { 
	title, 
	subtitle = '', 
	category = 'general', 
	type = 'preview',
	className = '' 
} = Astro.props;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const cleanSubtitle = subtitle?.endsWith('.') ? subtitle.slice(0, -1) : subtitle;

const rawCat = category || 'general';
const catKey = rawCat.toLowerCase().trim();
const rubric = t(`cat.${catKey}` as any) || rawCat;

// Category color class
const catClass = category === 'route' ? 'cat-route' :
                 category === 'forge' ? 'cat-forge' :
                 category === 'helm' ? 'cat-helm' :
                 category === 'treasury' ? 'cat-treasury' :
                 category === 'compass' ? 'cat-compass' :
                 category === 'logbook' ? 'cat-logbook' :
                 category === 'crew' ? 'cat-crew' : '';
---

<div class={`banner banner--${type} ${className}`}>
	<div class="banner-inner">
		<div class="banner-top">
			{title && <h2 class="banner-title">{title}</h2>}
			{cleanSubtitle && <p class="banner-subtitle">{cleanSubtitle}</p>}
		</div>
		<div class="banner-bottom">
			{rubric && <span class={`banner-rubric ${catClass}`}>{rubric}</span>}
			<span class="banner-watermark">FÉLAG</span>
		</div>
	</div>
</div>
