---
import { getLangFromUrl, useTranslations, useTranslatedPath } from '../../i18n/utils';
import { CATEGORIES } from '../../config/categories';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

const currentPath = Astro.url.pathname;
const isSaga = currentPath.includes('/saga');
const isAbout = currentPath.includes('/about');
const isCategory = currentPath.match(/\/(route|forge|helm|treasury|compass|logbook|crew)$/);

const categories = CATEGORIES.map((cat) => ({
	...cat,
	label: t(`cat.${cat.id}`),
	full: t(`cat.${cat.id}.full`),
	display: t(`cat.${cat.id}.display`),
	href: `/${lang}/saga/?categories=${cat.id}`,
}));
---

<nav class="desktop-nav" aria-label={t('nav.aria_label')}>
	<a href={translatePath('saga')} class:list={['nav-link', { active: isSaga }]} aria-current={isSaga ? 'page' : undefined}>{t('nav.saga')}</a>
	
	<!-- CATEGORIES DROPDOWN -->
	<div class="nav-dropdown">
		<button class="nav-link nav-dropdown-trigger" aria-expanded="false" aria-haspopup="true">
			<span class="dropdown-label">{t('home.categories_label')}</span>
			<span class="dropdown-chevron" aria-hidden="true">▾</span>
		</button>
		<div class="nav-dropdown-menu" role="menu">
			{categories.map(cat => {
				const isActive = isCategory?.[1] === cat.id;
				return (
					<a 
						href={cat.href} 
						class:list={['nav-dropdown-item', { active: isActive }]} 
						role="menuitem"
						title={cat.full}
					>
						<span class="cat-label">{cat.label}</span>
					</a>
				);
			})}
		</div>
	</div>
	
	<a href={translatePath('about')} class:list={['nav-link', { active: isAbout }]} aria-current={isAbout ? 'page' : undefined}>{t('nav.about')}</a>
</nav>
