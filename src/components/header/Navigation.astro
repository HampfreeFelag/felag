---
import { getLangFromUrl, useTranslations, useTranslatedPath } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

const currentPath = Astro.url.pathname;
const isSaga = currentPath.includes('/saga');
const isAbout = currentPath.includes('/about');
const isCategory = currentPath.match(/\/(route|forge|helm|treasury|compass|logbook|crew)$/);

const categories = [
	{ id: 'route', label: t('cat.route'), full: t('cat.route.full'), display: t('cat.route.display'), href: `/${lang}/route/` },
	{ id: 'forge', label: t('cat.forge'), full: t('cat.forge.full'), display: t('cat.forge.display'), href: `/${lang}/forge/` },
	{ id: 'helm', label: t('cat.helm'), full: t('cat.helm.full'), display: t('cat.helm.display'), href: `/${lang}/helm/` },
	{ id: 'treasury', label: t('cat.treasury'), full: t('cat.treasury.full'), display: t('cat.treasury.display'), href: `/${lang}/treasury/` },
	{ id: 'compass', label: t('cat.compass'), full: t('cat.compass.full'), display: t('cat.compass.display'), href: `/${lang}/compass/` },
	{ id: 'logbook', label: t('cat.logbook'), full: t('cat.logbook.full'), display: t('cat.logbook.display'), href: `/${lang}/logbook/` },
	{ id: 'crew', label: t('cat.crew'), full: t('cat.crew.full'), display: t('cat.crew.display'), href: `/${lang}/crew/` },
];
---

<nav class="desktop-nav" aria-label={t('nav.aria_label')}>
	<a href={translatePath('saga')} class:list={['nav-link', { active: isSaga }]} aria-current={isSaga ? 'page' : undefined}>{t('nav.saga')}</a>
	
	<!-- CATEGORIES DROPDOWN -->
	<div class="nav-dropdown">
		<button class="nav-link nav-dropdown-trigger" aria-expanded="false" aria-haspopup="true">
			<span class="dropdown-label">{t('home.categories_label')}</span>
			<span class="dropdown-chevron" aria-hidden="true">▾</span>
		</button>
		<div class="nav-dropdown-menu" role="menu">
			{categories.map(cat => {
				const isActive = isCategory?.[1] === cat.id;
				return (
					<a 
						href={cat.href} 
						class:list={['nav-dropdown-item', { active: isActive }]} 
						role="menuitem"
						title={cat.full}
					>
						<span class="cat-label">{cat.label}</span>
					</a>
				);
			})}
		</div>
	</div>
	
	<a href={translatePath('about')} class:list={['nav-link', { active: isAbout }]} aria-current={isAbout ? 'page' : undefined}>{t('nav.about')}</a>
</nav>
