---
/*
  LanguageSwitcher Component
  Single globe icon + current language abbreviation.
  Matches theme toggle aesthetic: same size, colors, hover animation.
*/
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// Determine the OTHER language to switch to
const targetLang = lang === 'ru' ? 'en' : 'ru';

// Utility to switch language in current URL
const getSwitchPath = (targetLang: string) => {
	const currentPath = Astro.url.pathname;
	const pathParts = currentPath.split('/').filter(Boolean);
	const langIndex = 0;
	
	if (pathParts.length > 0 && ['ru', 'en'].includes(pathParts[langIndex])) {
		pathParts[langIndex] = targetLang;
		let newPath = '/' + pathParts.join('/');
		if (!newPath.endsWith('/')) newPath += '/';
		return newPath;
	}
	return `/${targetLang}/`;
};

const switchPath = getSwitchPath(targetLang);
const currentLangUpper = lang.toUpperCase();
---

<a 
	href={switchPath}
	class="lang-switcher-btn"
	aria-label={`Switch to ${targetLang === 'ru' ? 'Russian' : 'English'}`}
>
	<svg class="lang-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" width="16" height="16">
		<circle cx="12" cy="12" r="10"/>
		<line x1="2" y1="12" x2="22" y2="12"/>
		<path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
	</svg>
	<span class="lang-text">{currentLangUpper}</span>
</a>

<style>
	.lang-switcher-btn {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		background: transparent;
		border: none;
		color: var(--lang-switcher-color);
		cursor: pointer;
		padding: 4px 8px;
		min-height: 44px;
		text-decoration: none;
		border-radius: var(--radius-sm);
		transition: color var(--duration-fast) var(--ease-out);
		font-family: var(--font-sans);
		font-size: 0.8rem;
		font-weight: 500;
	}
	.lang-switcher-btn:hover {
		color: var(--lang-switcher-hover);
		transform: rotate(-8deg);
		transition: color var(--duration-fast) var(--ease-out), transform var(--duration-normal) var(--ease-out);
	}
	.lang-icon {
		flex-shrink: 0;
		transition: transform var(--duration-normal) var(--ease-out);
	}
	.lang-text {
		line-height: 1;
	}
</style>
