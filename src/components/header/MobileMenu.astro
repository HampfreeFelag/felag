---
/*
  MobileMenu Component
  Includes navigation links, language switcher and theme toggle for mobile view.
*/
import { getLangFromUrl, useTranslations, useTranslatedPath } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

const currentPath = Astro.url.pathname;
const isSaga = currentPath.includes('/saga');
const isAbout = currentPath.includes('/about');

// Determine the OTHER language to switch to
const targetLang = lang === 'ru' ? 'en' : 'ru';

// Utility to switch language in current URL
const getSwitchPath = (targetLang: string) => {
	const pathParts = currentPath.split('/').filter(Boolean);
	const langIndex = 0;
	
	if (pathParts.length > 0 && ['ru', 'en'].includes(pathParts[langIndex])) {
		pathParts[langIndex] = targetLang;
		let newPath = '/' + pathParts.join('/');
		if (!newPath.endsWith('/')) newPath += '/';
		return newPath;
	}
	return `/${targetLang}/`;
};
---

<!-- MOBILE MENU -->
<div id="mobile-menu" class="mobile-menu" aria-label={t('mobile.menu_aria_label')}>
	<nav class="mobile-nav-links">
		<a href={translatePath('saga')} class={isSaga ? 'active' : ''} aria-current={isSaga ? 'page' : undefined}>{t('nav.saga')}</a>
		<a href={translatePath('about')} class={isAbout ? 'active' : ''} aria-current={isAbout ? 'page' : undefined}>{t('nav.about')}</a>
	</nav>
	
	<!-- Mobile: Languages — single globe toggle -->
	<div class="mobile-lang-switcher">
		<span class="mobile-menu-label">{t('mobile.lang_label')}</span>
		<a 
			href={getSwitchPath(targetLang) + '?menu=open'}
			class="mobile-lang-btn"
			aria-label={`Switch to ${targetLang === 'ru' ? 'Russian' : 'English'}`}
			onclick={(e) => {
				e.preventDefault();
				localStorage.setItem('scrollY', String(window.scrollY));
				window.location.href = getSwitchPath(targetLang) + '?menu=open';
			}}
		>
			<svg class="mobile-lang-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" width="16" height="16">
				<circle cx="12" cy="12" r="10"/>
				<line x1="2" y1="12" x2="22" y2="12"/>
				<path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
			</svg>
			<span>{targetLang.toUpperCase()}</span>
		</a>
	</div>
	
	<!-- Mobile: Theme -->
	<div class="mobile-theme-switcher">
		<button id="theme-toggle-mobile" class="theme-btn-mobile" aria-label={t('theme.toggle')}>
			<svg class="theme-icon-mobile" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" width="18" height="18">
				<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
			</svg>
		</button>
	</div>
</div>

<style>
	.mobile-nav-links {
		display: flex;
		flex-direction: column;
		gap: 8px;
	}

	.mobile-lang-switcher {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		padding: 0;
		align-items: flex-start;
	}

	.mobile-menu-label {
		font-family: var(--font-mono);
		font-weight: 400;
		font-size: 0.7rem;
		color: var(--color-text-tertiary);
		text-transform: uppercase;
		letter-spacing: 0.1em;
	}

	.mobile-lang-btn {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		background: transparent;
		border: none;
		color: var(--color-text-secondary);
		cursor: pointer;
		padding: 0.5rem 0;
		font-family: var(--font-mono);
		font-size: 0.85rem;
		font-weight: 500;
		text-decoration: none;
		transition: color var(--duration-fast) var(--ease-out);
		min-height: 44px;
	}

	.mobile-lang-btn:hover {
		color: var(--color-accent);
	}

	.mobile-lang-icon {
		flex-shrink: 0;
	}

	/* Mobile theme button — clean icon only, no box */
	.theme-btn-mobile {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		background: transparent;
		border: none;
		color: var(--color-text-secondary);
		cursor: pointer;
		padding: 0.5rem 0;
		font-family: var(--font-mono);
		font-size: 0.85rem;
		font-weight: 500;
		text-decoration: none;
		transition: color var(--duration-fast) var(--ease-out);
		min-height: 44px;
		border-radius: 0;
		box-shadow: none;
	}

	.theme-btn-mobile:hover {
		color: var(--color-accent);
	}

	.theme-icon-mobile {
		flex-shrink: 0;
	}
</style>
