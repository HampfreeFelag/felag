---
// AdBanner.astro — in-article ad banner (SSR, scoped styles)
// Clickable CTA only. Data attributes on container, NOT on <a>.

interface Props {
  title: string;
  subtitle: string;
  cta: string;
  link: string;
  erid: string;
  advertiser?: { name: string };
  bannerId: string;
  isInternal: boolean;
}

const { title, subtitle, cta, link, erid, advertiser, bannerId, isInternal } = Astro.props;
---

<div class="ad-banner" data-banner-id={bannerId} data-banner-name={title} data-banner-link={link}>
  <a class="ad-banner-content" href={link}
     rel={isInternal ? undefined : 'nofollow sponsored noopener noreferrer'}
     target={isInternal ? undefined : '_blank'}>
    <div class="text-block">
      <p class="title">{title}</p>
      <p class="subtitle">{subtitle}</p>
    </div>
    <span class="cta">{cta}</span>
  </a>
  {erid && !isInternal && (
    <span class="ad-banner-mark">Реклама · {advertiser?.name || ''} · erid: {erid}</span>
  )}
</div>

<style>
  .ad-banner {
    max-width: var(--content-max, 100%);
    margin: 2rem auto;
    width: 100%;
  }
  .ad-banner-content {
    display: flex;
    flex-direction: row;
    gap: clamp(12px, 2vw, 16px);
    align-items: center;
    text-decoration: none;
    padding: clamp(16px, 3vw, 24px) clamp(20px, 4vw, 28px);
    background: var(--color-bg-subtle);
    border: 1px solid var(--color-border);
    border-radius: 4px;
    color: var(--color-text);
  }
  .text-block { flex: 1; min-width: 0; }
  .title {
    font-family: var(--font-serif);
    font-size: clamp(0.95rem, 2vw, 1.15rem);
    font-weight: 600;
    line-height: 1.3;
    margin: 0 0 4px;
    color: var(--color-text);
  }
  .subtitle {
    font-size: clamp(0.8rem, 1.5vw, 0.9rem);
    color: var(--color-text-secondary);
    line-height: 1.5;
    margin: 0;
  }
  .cta {
    flex-shrink: 1;
    padding: clamp(0.4rem, 1vw, 0.5rem) clamp(0.8rem, 1.5vw, 1rem);
    background: var(--color-amber);
    color: #FFF;
    border-radius: 3px;
    text-align: center;
    text-decoration: none;
    font-family: var(--font-mono);
    font-size: clamp(0.75rem, 1.2vw, 0.85rem);
    font-weight: 500;
    white-space: nowrap;
  }
  @media (hover: hover) { .cta:hover { opacity: 0.85; } }
  .cta:focus-visible { outline: 2px solid var(--color-amber); outline-offset: 2px; }
  .ad-banner-mark {
    display: block;
    width: 100%;
    font-size: 0.65rem;
    color: var(--color-text-tertiary);
    margin-top: 8px;
    hyphens: none;
    word-break: normal;
  }
  @media (max-width: 767px) {
    .ad-banner-content { flex-direction: column; align-items: stretch; gap: 12px; }
    .cta { flex-shrink: 0; align-self: stretch; }
  }
</style>
